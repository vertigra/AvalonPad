<UserControl x:Class="AvalonPad.Shell.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            
        </Grid.RowDefinitions>

        <!-- Заголовок + кнопка Сохранить -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock FontWeight="Bold" 
                       FontSize="16"
                       Text="Настройки приложения" 
                       DockPanel.Dock="Left"
                       VerticalAlignment="Center" />
        </DockPanel>

        <!-- Настройки -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Width="800" HorizontalAlignment="Left">

                <!-- Редактор -->
                <GroupBox Header="Редактор" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <Label Content="Шрифт:" />
                        <ComboBox Margin="0,0,0,12"
                                  ItemsSource="{Binding AvailableFonts}"
                                  SelectedItem="{Binding SettingsService.Current.EditorFontFamily, Mode=TwoWay}">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="FontFamily" Value="{Binding}" />
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>

                        <Label Content="Размер шрифта:" />
                        <ComboBox Margin="0,0,0,12"
                                  ItemsSource="{Binding AvailableFontSizes}"
                                  SelectedItem="{Binding SettingsService.Current.EditorFontSize, Mode=TwoWay}" />
                 
                    </StackPanel>
                </GroupBox>

                <!-- Логи -->
                <GroupBox Header="Логирование" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <Label Content="Уровень логов (UI):" />
                        <TextBox Margin="0,0,0,12"
                                 IsEnabled="False"
                                 Text="{Binding SettingsService.Current.OutputLogLevel, 
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}"  />

                        <Label Content="Уровень логов (Глобально):" />
                        <TextBox Margin="0,0,0,12"
                                 IsEnabled="False"
                                 Text="{Binding SettingsService.Current.GlobalLogLevel, 
                                                Mode=TwoWay, 
                                                UpdateSourceTrigger=PropertyChanged}"  />

                        <Label Content="Путь к файлу логов относительно папки приложения:" />
                        <TextBox Margin="0,0,0,12" 
                                 IsReadOnly="True"
                                 IsEnabled="False"
                                 Text="{Binding SettingsService.Current.LogFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  />

                        <Label Content="Количество дней хранения логов (после удаляются):" />
                        <TextBox Margin="0,0,0,12" 
                                 IsReadOnly="True"
                                 Text="{Binding SettingsService.Current.RetainedFileCountLimit, 
                                                Mode=TwoWay, 
                                                UpdateSourceTrigger=PropertyChanged}"  />

                        <Label Content="Шаблон вывода логов в файл (Serilog outputTemplate):" />
                        <TextBox Margin="0,0,0,12" 
                                 IsReadOnly="True"
                                 IsEnabled="False"
                                 Text="{Binding SettingsService.Current.FileLogTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
            
        </ScrollViewer>


        <DockPanel Grid.Row="2" 
                   Margin="0,10,0,0"
                   LastChildFill="False">

            <Button Content="Сохранить"
                    Padding="12,4"
                    Command="{Binding DataContext.SaveFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    DockPanel.Dock="Right" />

        </DockPanel>
        
    </Grid>
</UserControl>