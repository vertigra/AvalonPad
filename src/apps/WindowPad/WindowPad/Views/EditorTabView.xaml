<UserControl x:Class="WindowPad.Views.EditorTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Заголовок документа + индикатор несохранённых изменений -->
        <TextBlock Grid.Row="0"
                   FontWeight="Bold"
                   Margin="0,0,0,4"
                   Text="{Binding Title}"/>

        <!-- Редактор содержимого -->
        <!-- Tекст автоматически переносится на новую строку, он никогда не превысит ширину поля поэтому HorizontalScrollBarVisibility="Disabled" -->
        <TextBox Grid.Row="1"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled"
                 TextWrapping="Wrap"
                 FontFamily="{Binding SettingsService.Current.EditorFontFamily}"
                 FontSize="{Binding SettingsService.Current.EditorFontSize}"
                 Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" />
    </Grid>
</UserControl>
