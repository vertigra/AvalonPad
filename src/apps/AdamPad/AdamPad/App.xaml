<Application x:Class="AdamPad.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AdamPad.ViewModels"
             xmlns:views="clr-namespace:AdamPad.Views"
             xmlns:shellvm="clr-namespace:AvalonPad.Shell.ViewModels;assembly=AvalonPad.Shell"
             xmlns:shellviews="clr-namespace:AvalonPad.Shell.Views;assembly=AvalonPad.Shell"
             ShutdownMode="OnMainWindowClose">

    <Application.Resources>
        <!-- Глобальные DataTemplates: связывают ViewModel с их View.
             AvalonDock (и любой другой ItemsControl) автоматически
             применит этот шаблон, когда встретит EditorTabViewModel
             в DocumentsSource или PropertiesToolbox в AnchorablesSource. -->

        <DataTemplate DataType="{x:Type vm:EditorTabViewModel}">
            <views:EditorTabView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type shellvm:PropertiesToolboxViewModel}">
            <shellviews:PropertiesToolView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type shellvm:OutputToolboxViewModel}">
            <shellviews:OutputToolView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type shellvm:SettingsViewModel}">
            <shellviews:SettingsView />
        </DataTemplate>

    </Application.Resources>
</Application>
